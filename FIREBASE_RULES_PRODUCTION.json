{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".indexOn": ["username"],
      "$uid": {
        ".read": "$uid === auth.uid || root.child('users').child($uid).child('public').exists()",
        ".write": "$uid === auth.uid && (!data.exists() || (newData.child('premium').val() === data.child('premium').val() && newData.child('email').val() === data.child('email').val() && newData.child('blocked').val() === data.child('blocked').val() && newData.child('verified').val() === data.child('verified').val() && newData.child('lastDailyClaim').val() === data.child('lastDailyClaim').val() && newData.child('dailyClaimStreak').val() === data.child('dailyClaimStreak').val() && newData.child('longestDailyStreak').val() === data.child('longestDailyStreak').val() && newData.child('bio').val() === data.child('bio').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('badUploads').val() === data.child('badUploads').val() && newData.child('username').val() === data.child('username').val() && (!data.child('completedMissionsToday').child('0').exists() || newData.child('completedMissionsToday').child('0').exists()) && (!data.child('completedMissionsToday').child('1').exists() || newData.child('completedMissionsToday').child('1').exists()) && (!data.child('completedMissionsToday').child('2').exists() || newData.child('completedMissionsToday').child('2').exists())))",

        "username": {".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 30"},
        "pts": {".read": true, ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() === data.val()"},
        "seasonPts": {".read": true, ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() === data.val()"},
        "missions": {".read": true, ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"},
        "country": {".read": true, ".validate": "newData.isString() && newData.val().length <= 50"},
        "streak": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 365"},
        "lastDailyClaim": {".write": false},
        "dailyClaimStreak": {".write": false},
        "longestDailyStreak": {".write": false},
        "verified": {".validate": "newData.isBoolean()"},
        "premium": {".read": true, ".write": false, ".validate": "newData.isBoolean()"},
        "blocked": {".validate": "newData.isBoolean()"},
        "pushEnabled": {".validate": "newData.isBoolean()"},
        "agreedToTerms": {".validate": "newData.isBoolean()"},
        "consentAt": {".validate": "newData.isNumber()"},
        "email": {".write": "false"},
        "createdAt": {".write": "false"},
        "public": {".read": true},

        "privacy": {
          ".read": true,
          ".write": "$uid === auth.uid",
          "privateProfile": {".validate": "newData.isBoolean()"},
          "hideFromLeaderboard": {".validate": "newData.isBoolean()"},
          "dmFollowersOnly": {".validate": "newData.isBoolean()"},
          "$other": {".validate": false}
        },

        "avatarURL": {".read": true, ".write": "$uid === auth.uid", ".validate": "newData.isString() && newData.val().length <= 600"},
        "avatarColor": {".read": true, ".write": "$uid === auth.uid", ".validate": "newData.isString() && newData.val().length <= 9"},
        "bio": {".read": true, ".write": false, ".validate": "newData.isString() && newData.val().length <= 300"},
        "title": {".read": true, ".write": "$uid === auth.uid", ".validate": "newData.isString() && newData.val().length <= 30"},
        "link": {".read": true, ".write": "$uid === auth.uid", ".validate": "newData.isString() && newData.val().length <= 200"},
        "age": {".read": true, ".write": "$uid === auth.uid", ".validate": "newData.isNumber() && newData.val() >= 13 && newData.val() <= 120"},
        "profileCountry": {".read": true, ".write": "$uid === auth.uid", ".validate": "newData.isString() && newData.val().length <= 60"},

        "completedMissionsToday": {
          ".read": "$uid === auth.uid",
          ".write": false
        },
        "followers": {
          ".read": true,
          ".write": false
        },
        "following": {
          ".read": true,
          ".write": false
        },
        "blockedUploads": {
          ".read": false,
          ".write": false
        }
      }
    },

    "languages": {
      ".read": true,
      ".write": false
    },

    "feed": {
      ".read": "auth !== null",
      ".indexOn": ["uid", "timestamp", "pts", "createdAt", "status"],

      "$postId": {
        ".write": "auth !== null && data.exists() && data.child('uid').val() === auth.uid && !newData.exists()",
        ".validate": "!newData.exists() || newData.hasChildren(['uid','timestamp'])",
        "uid": {".validate": "newData.val() === auth.uid || newData.val() === data.child('uid').val()"},
        "timestamp": {".validate": "newData.isNumber()"},
        "status": {".validate": "newData.val() === 'verified' || newData.val() === 'pending' || newData.val() === 'rejected'"},
        "pts": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && (!data.exists() || newData.val() <= data.val() + 50000)"},
        "likes": {".write": false, ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() === (data.exists() ? data.val() : 0) || newData.val() === (data.exists() ? data.val() : 0) + 1 || newData.val() === (data.exists() ? data.val() : 0) - 1)"},
        "views": {".write": false, ".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() === (data.exists() ? data.val() : 0) || newData.val() === (data.exists() ? data.val() : 0) + 1)"},
        "music": {".validate": "newData.isString() && newData.val().length <= 20"}
      }
    },

    "comments": {
      ".read": "auth !== null",
      ".indexOn": ["postId", "timestamp", "createdAt", "at", "replyCount"],

      "$postId": {
        ".indexOn": ["at"],
        "$commentId": {
          ".write": "auth !== null && data.exists() && data.child('uid').val() === auth.uid && !newData.exists()",
          ".validate": "!newData.exists() || newData.hasChildren(['uid','text','at'])",
          "uid": {".validate": "newData.val() === auth.uid"},
          "username": {".validate": "newData.isString() && newData.val().length <= 30"},
          "text": {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"},
          "at": {".validate": "newData.isNumber()"},
          "createdAt": {".validate": "newData.isNumber()"},
          "edited": {".validate": "newData.isBoolean()"},
          "parentId": {".validate": "newData.isString() && newData.val().length <= 60"},
          "replyCount": {".validate": "newData.isNumber() && newData.val() >= 0"},
          "likeCount": {".validate": "newData.isNumber() && newData.val() >= 0"},
          "$other": {".validate": false}
        }
      }
    },

    "commentLikes": {
      "$postId": {
        "$commentId": {
          "$uid": {
            ".read": "auth !== null",
            ".write": "$uid === auth.uid",
            ".validate": "newData.val() === true || newData.val() === null"
          }
        }
      }
    },

    "userLikes": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",

        "$postId": {
          ".validate": "newData.val() === true || newData.val() === null"
        }
      }
    },

    "userSaves": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",

        "$postId": {
          ".validate": "newData.hasChildren(['timestamp']) || newData.val() === null",
          "timestamp": {".validate": "newData.isNumber()"}
        }
      }
    },

    "follows": {
      "$uid": {
        ".read": true,
        ".write": "$uid === auth.uid",
        ".indexOn": ["timestamp"],
        "$target": { ".validate": "newData.val() === true || newData.val() === null || newData.hasChildren()" }
      }
    },

    "followers": {
      "$uid": {
        ".read": true,
        "$follower": {
          ".write": "$follower === auth.uid",
          ".validate": "newData.val() === true || newData.val() === null || newData.hasChildren()"
        }
      }
    },

    "hashtags": {
      ".read": "auth !== null",
      ".write": false,
      ".indexOn": ["timestamp", "likes"],
      "$tag": {
        ".read": "auth !== null"
      }
    },

    "hashtagStats": {
      ".read": "auth !== null",
      ".write": false,
      ".indexOn": ["postCount", "lastUpdated"]
    },

    "notifications": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        ".indexOn": ["createdAt", "read", "byUid"],
        "$nid": {
          ".write": "auth !== null && !data.exists()",
          ".validate": "newData.hasChildren(['type','createdAt']) && (newData.child('byUid').val() === auth.uid || $uid === auth.uid)"
        }
      }
    },

    "blocked": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },

    "userBlocked": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },

    "userMuted": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },

    "userStorage": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },

    "stats": {
      ".read": "auth !== null && auth.token.email === 'shahar070510@gmail.com'",
      "missionDone": {
        "$mid": { ".write": "auth !== null", ".validate": "newData.isNumber()" }
      },
      "dau": {
        "$date": {
          "$uid": { ".write": "$uid === auth.uid", ".validate": "newData.val() === true" }
        }
      }
    },

    "reports": {
      ".read": "auth !== null && auth.token.email === 'shahar070510@gmail.com'",
      ".write": "auth !== null",
      ".indexOn": ["createdAt", "status"],
      "$reportId": {
        ".validate": "newData.hasChildren(['byUid','reportedUid','reason','createdAt'])",
        "byUid": {".validate": "newData.val() === auth.uid || auth.token.email === 'shahar070510@gmail.com'"},
        "reason": {".validate": "newData.val() === 'harassment' || newData.val() === 'spam' || newData.val() === 'abuse' || newData.val() === 'inappropriate' || newData.val() === 'hate_speech' || newData.val() === 'scam'"},
        "status": {".validate": "newData.val() === 'pending' || newData.val() === 'reviewed' || newData.val() === 'actioned'"}
      }
    },

    "usernames": {
      ".read": "auth !== null",
      ".indexOn": [".value"],
      "$uname": {
        ".write": "auth !== null && !data.exists()",
        ".validate": "newData.val() === auth.uid"
      }
    },

    "leaderboard": {
      ".read": "auth !== null",
      ".indexOn": ["pts", "seasonPts"],
      "$uid": {
        ".write": "$uid === auth.uid && (!data.exists() || newData.child('username').val() === data.child('username').val())",
        "username": {".validate": "newData.isString() && newData.val().length <= 30"},
        "pts": {".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() === data.val() || newData.val() === root.child('users').child($uid).child('pts').val())"},
        "missions": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"},
        "streak": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 365"},
        "seasonPts": {".validate": "newData.isNumber() && newData.val() >= 0 && (newData.val() === data.val() || newData.val() === root.child('users').child($uid).child('seasonPts').val())"},
        "country": {".validate": "newData.isString() && newData.val().length <= 60"},
        "$other": {".validate": false}
      }
    },

    "seasonWinners": {
      ".read": "auth !== null",
      ".write": false
    },

    "premiumInterest": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "at": {".validate": "newData.isNumber()"},
        "email": {".validate": "newData.isString() && newData.val().length <= 254"},
        "$other": {".validate": false}
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth !== null && $chatId.contains(auth.uid)",

        "members": {
          "$memberUid": {
            ".write": "auth !== null && $chatId.contains(auth.uid) && $chatId.contains($memberUid)",
            ".validate": "newData.val() === true"
          }
        },

        "messages": {
          ".indexOn": ["at"],
          "$msgId": {
            ".write": false,
            ".validate": "newData.hasChildren(['from','at']) && (newData.hasChild('text') || newData.hasChild('img'))",
            "from": {".validate": "newData.val() === auth.uid"},
            "text": {".validate": "newData.isString() && newData.val().length <= 500"},
            "img": {".validate": "newData.isString() && newData.val().length < 600"},
            "at": {".validate": "newData.isNumber()"},
            "$other": {".validate": false}
          }
        }
      }
    },

    "fcmTokens": {
      "$uid": {
        ".read": false,
        ".write": "$uid === auth.uid",
        "token": {".validate": "newData.isString() && newData.val().length < 512"},
        "updatedAt": {".validate": "newData.isNumber()"},
        "$other": {".validate": false}
      }
    },

    "userInteractions": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },

    "chatMeta": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".indexOn": ["lastAt"],

        "$chatId": {
          ".write": "auth !== null && $chatId.contains(auth.uid) && $chatId.contains($uid)",
          "peerUid": {".validate": "newData.isString()"},
          "peerName": {".validate": "newData.isString() && newData.val().length <= 30"},
          "lastText": {".validate": "newData.isString() && newData.val().length <= 500"},
          "lastAt": {".validate": "newData.isNumber()"},
          "unread": {".validate": "newData.isNumber() && newData.val() >= 0"},
          "$other": {".validate": false}
        }
      }
    },

    "rooms": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && !newData.exists() && !data.child('members').exists()",
        "meta": {
          ".write": "auth != null && (!data.exists() || (data.child('host').val() === auth.uid && newData.child('mission').val() === data.child('mission').val()))",
          ".validate": "newData.hasChildren(['host'])",
          "host": {".validate": "newData.val() === auth.uid || data.exists()"},
          "hostName": {".validate": "newData.isString() && newData.val().length <= 40"},
          "createdAt": {".validate": "newData.isNumber()"},
          "mission": {".validate": "newData.isString() && newData.val().length <= 140"},
          "$other": {".validate": false}
        },
        "members": {
          "$uid": {
            ".write": "($uid === auth.uid && !root.child('rooms').child($code).child('banned').child(auth.uid).exists()) || (root.child('rooms').child($code).child('meta').child('host').val() === auth.uid && !newData.exists())",
            ".validate": "newData.hasChildren(['name','at'])",
            "name": {".validate": "newData.isString() && newData.val().length <= 40"},
            "at": {".validate": "newData.isNumber()"},
            "$other": {".validate": false}
          }
        },
        "banned": {
          "$uid": {
            ".read": "auth != null",
            ".write": "root.child('rooms').child($code).child('meta').child('host').val() === auth.uid || root.child('rooms').child($code).child('mods').child(auth.uid).val() === true",
            ".validate": "newData.val() === true"
          }
        },
        "mods": {
          "$uid": {
            ".read": "auth != null",
            ".write": "root.child('rooms').child($code).child('meta').child('host').val() === auth.uid",
            ".validate": "newData.val() === true"
          }
        },
        "chat": {
          ".indexOn": ["at"],
          "$mid": {
            ".write": false,
            ".validate": "newData.hasChildren(['uid','name','text','at'])",
            "uid": {".validate": "newData.val() === auth.uid"},
            "name": {".validate": "newData.isString() && newData.val().length <= 40"},
            "text": {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"},
            "at": {".validate": "newData.isNumber()"},
            "$other": {".validate": false}
          }
        },
        "posts": {
          ".indexOn": ["at"],
          "$pid": {
            ".write": "auth != null && data.exists() && (data.child('uid').val() === auth.uid || ((root.child('rooms').child($code).child('meta').child('host').val() === auth.uid || root.child('rooms').child($code).child('mods').child(auth.uid).val() === true) && !newData.exists()))",
            ".validate": "newData.hasChildren(['uid','at'])",
            "uid": {".validate": "newData.val() === auth.uid"},
            "name": {".validate": "newData.isString() && newData.val().length <= 40"},
            "caption": {".validate": "newData.isString() && newData.val().length <= 300"},
            "mediaURL": {".validate": "newData.isString() && newData.val().length <= 600"},
            "mediaType": {".validate": "newData.val() === 'image' || newData.val() === 'video'"},
            "at": {".validate": "newData.isNumber()"},
            "$other": {".validate": false}
          }
        }
      }
    }
  }
}
